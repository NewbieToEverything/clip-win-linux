#!/usr/bin/python3
import argparse
import fcntl
import io
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import time
import uuid

HOME = Path.home()
LIMIT = 15 * 1024 * 1024
VARIABLES = ('CLIPBRIDGE_WS', 'DISPLAY', 'XAUTHORITY', 'WAYLAND_DISPLAY')


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def main():
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest='command', required=True)
    for name in ('init', 'serve', 'env', 'receive', 'doctor', 'latest', 'prune', 'tmux-bind'):
        command = commands.add_parser(name)
        command.add_argument('workspace', choices=('workspace-a', 'workspace-b'))
        if name == 'init':
            command.add_argument('display', choices=(':201', ':202'))
        if name == 'prune':
            command.add_argument('--days', type=int, default=14)
        if name == 'tmux-bind':
            command.add_argument('session')
    args = parser.parse_args()
    workspace = args.workspace
    display = {'workspace-a': ':201', 'workspace-b': ':202'}[workspace]
    state = HOME / '.local/state/clipbridge' / workspace
    auth = state / 'Xauthority'
    cache = HOME / '.cache/clipbridge' / workspace
    images = cache / 'images'
    latest = cache / 'latest.json'
    config = state / 'config.json'
    command = args.command
    if command == 'init':
        if args.display != display:
            raise ValueError(f'{workspace} requires {display}')
        state.mkdir(parents=True, exist_ok=True)
        with (state / 'init.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if config.exists():
                if not auth.is_file():
                    raise ValueError('Xauthority is missing')
                return
            number = display[1:]
            if Path(f'/tmp/.X11-unix/X{number}').exists() or Path(f'/tmp/.X{number}-lock').exists():
                raise ValueError(f'Display {display} is occupied')
            auth.touch(exist_ok=True)
            run('xauth', '-q', '-f', str(auth), 'source', '-',
                input=f'add {display} . {os.urandom(16).hex()}\n', text=True)
            config.write_text(json.dumps({'display': display}) + '\n')
        return
    if json.loads(config.read_text())['display'] != display or not auth.is_file():
        raise ValueError('Invalid workspace configuration')
    values = dict(zip(VARIABLES[:3], (workspace, display, str(auth))))
    if command == 'env':
        for key, value in values.items():
            print(f'export {key}={shlex.quote(value)}')
        print('unset WAYLAND_DISPLAY')
        return
    if command == 'serve':
        os.execv('/usr/bin/Xvfb', ['Xvfb', display, '-auth', str(auth), '-nolisten', 'tcp'])
    env = os.environ | values
    env.pop('WAYLAND_DISPLAY', None)
    if command == 'doctor':
        run('xdpyinfo', env=env, stdout=subprocess.DEVNULL, timeout=5)
        print(f'{workspace} {display}: OK')
        return
    if command == 'tmux-bind':
        target = '=' + args.session
        options = run('tmux', 'show-options', '-Av', '-t', target, 'update-environment',
                      capture_output=True, text=True).stdout.split()
        for key, value in values.items():
            run('tmux', 'set-environment', '-t', target, key, value)
        run('tmux', 'set-environment', '-r', '-t', target, 'WAYLAND_DISPLAY')
        run('tmux', 'set-option', '-t', target, 'update-environment',
            ' '.join(option for option in options if option not in VARIABLES))
        return
    if command == 'receive':
        from PIL import Image
        data = sys.stdin.buffer.read(LIMIT + 1)
        if len(data) > LIMIT or not data.startswith(b'\x89PNG\r\n\x1a\n'):
            raise ValueError('Expected a PNG of at most 15 MiB')
        with Image.open(io.BytesIO(data), formats=['PNG']) as image:
            if image.width * image.height > 25_000_000 or getattr(image, 'n_frames', 1) != 1:
                raise ValueError('Expected one image of at most 25 megapixels')
            image.verify()
        with Image.open(io.BytesIO(data), formats=['PNG']) as image:
            image.load()
    images.mkdir(parents=True, exist_ok=True)
    with (cache / 'publish.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if command == 'receive':
            run('xdpyinfo', env=env, stdout=subprocess.DEVNULL, timeout=5)
            path = images / f'{uuid.uuid4().hex}.png'
            path.write_bytes(data)
            run('xclip', '-selection', 'clipboard', '-t', 'image/png', '-i', str(path),
                env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
            for _ in range(20):
                result = subprocess.run(
                    ['xclip', '-selection', 'clipboard', '-o', '-t', 'image/png'],
                    env=env, capture_output=True, timeout=5)
                if result.returncode == 0 and result.stdout == data:
                    break
                time.sleep(0.05)
            else:
                raise ValueError('Clipboard readback did not match the uploaded image')
            temporary = latest.with_suffix('.tmp')
            temporary.write_text(json.dumps({'path': str(path)}) + '\n')
            temporary.replace(latest)
            print(path)
            return
        path = Path(json.loads(latest.read_text())['path']) if latest.exists() else None
        if command == 'latest':
            if path is None or not path.is_file():
                raise ValueError('No cached image')
            print(path)
            return
        if args.days < 1:
            raise ValueError('--days must be positive')
        cutoff = time.time() - args.days * 86400
        for item in images.glob('*.png'):
            if item != path and item.stat().st_mtime < cutoff:
                item.unlink()
                print(item)


if __name__ == '__main__':
    os.umask(0o077)
    if sys.argv[1:] in (['doctor'], ['latest']) or (
            sys.argv[1:2] == ['receive'] and sys.argv[2:3]
            and sys.argv[2].startswith('--format')):
        from clipbridge_path import main as path_main
        sys.exit(path_main(sys.argv[1:]))
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'clipbridge: {error}', file=sys.stderr)
        sys.exit(1)
